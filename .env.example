# ============================================================
#  yt-tagme-bot — конфигурация через переменные окружения
#  Скопируйте этот файл в `.env` и заполните секреты.
# ============================================================

# --- Секреты -------------------------------------------------
# YouTube Data API v3 key (https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=

# MiMo V2.6 Flash: API key и OpenAI-совместимый endpoint
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash
# MiMo V2.6 Flash — thinking-модель; false = прямой ответ (иначе тратит токены на reasoning)
MIMO_ENABLE_THINKING=false
MIMO_TIMEOUT=90

# --- TagMe ---------------------------------------------------
TAGME_URL=https://tagme.sberdevices.ru/marker/runner/73987d36-e911-4cb5-8013-b5b62d6c203e

# --- Пути ----------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PLAYWRIGHT_PROFILE_DIR=./browser_profile
LOGS_DIR=./logs
TEMP_DIR=./temp
SEARCH_QUERIES_PATH=./config/search_queries.yaml

# --- Поведение ----------------------------------------------
# DRY_RUN=true  -> ищет и анализирует, но НЕ нажимает «Отправить»
# DRY_RUN=false -> реальная отправка в TagMe
DRY_RUN=true
# HEADLESS=false -> видимое окно браузера (нужно для первой авторизации)
HEADLESS=false
SLOW_MO_MS=0

# --- Квоты и объёмы ------------------------------------------
# Приблизительный бюджет квоты YouTube (дневной лимит обычно 10000)
YOUTUBE_QUOTA_BUDGET=9000
MAX_CHANNELS=10
MAX_SEARCH_PAGES=1
SEARCH_MAX_RESULTS=30

# --- Фильтры каналов -----------------------------------------
MIN_CHANNEL_VIDEOS=10
MIN_SUITABLE_RATIO=0.30
MIN_REQUIRED_CHECKED=3
MAX_VIDEOS_PER_CHANNEL=20
# Доля Shorts/live в выборке загрузок; 0.0 = строго запрещены
MAX_SHORTS_RATIO=0.0
MAX_SUBSCRIBERS=0
MAX_VIEWS=0

# --- Фильтры видео -------------------------------------------
MIN_DURATION_SECONDS=5
MAX_DURATION_SECONDS=14400
MIN_HEIGHT=720
SHORTS_MAX_DURATION=180

# --- Кадры для MiMo ------------------------------------------
FRAME_COUNT=3
# 3 кадра: начало / середина / конец (10% / 50% / 90%)
FRAME_FRACTIONS=0.10,0.50,0.90
# Для MiMo DEEP (если QUICK неуверен) — дополнительные точки
FRAME_FALLBACK_FRACTIONS=0.30,0.70
FRAME_FORMAT=jpg
FRAME_QUALITY=3
# Кап ширины кадра для MiMo (экономия визуальных токенов)
FRAME_MAX_WIDTH=1280
# Для видео короче этого порога точки распределяются равномерно
SHORT_VIDEO_THRESHOLD=30
# Пауза между yt-dlp обращениями (против bot-check)
YTDLP_DELAY=1.0
# Путь к серверу PO-token (build/main.js) для обхода bot-check YouTube (необязательно)
POT_SERVER_DIR=
# Путь к cookies.txt YouTube (обходит bot-check с датацентр-IP). Пусто = не использовать.
COOKIES_FILE=

# --- Discovery (улучшенный) ---------------------------------
DISCOVERY_WORKERS=4
MAX_DISCOVERY_WORKERS=6
RESULTS_PER_QUERY=50
EXPLOIT_RATIO=0.70
EXPLORE_RATIO=0.20
RANDOM_RATIO=0.10
ENABLE_QUERY_SCORING=true
ENABLE_DYNAMIC_QUERY_GENERATION=false
DYNAMIC_QUERY_MAX_PER_CANDIDATE=5
DISCOVERY_MIN_DURATION=5
LOW_VIEW_THRESHOLD_1=1000
LOW_VIEW_THRESHOLD_2=3000
LOW_VIEW_THRESHOLD_3=10000
DEEP_CONFIDENCE_THRESHOLD=0.7

# --- Технический анализ статичности --------------------------
STATIC_MIN_DURATION=1800
STATIC_SAMPLE_FRAMES=12
STATIC_MOTION_THRESHOLD=0.02
STATIC_SCALE_WIDTH=200

# --- MiMo ----------------------------------------------------
MIMO_MAX_TOKENS=2048
MIMO_TEMPERATURE=0.1
MIMO_USE_RESPONSE_FORMAT=false
MIMO_RETRIES=3
MIMO_MIN_CONFIDENCE=0.5

# --- DeepSeek (vision через Messages API /v1/messages) --------
# DEEPSEEK_ENABLED=false -> оценщик кадров остаётся MiMo (по умолчанию).
# DEEPSEEK_ENABLED=true  -> кадры оценивает DeepSeek (быстрее MiMo).
# Важно: DeepSeek принимает картинки только через Messages API (блок image/base64),
# а не через OpenAI image_url.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://llm.azati.ai
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=180
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_RETRIES=3

# --- Локальный VLM pre-filter (экономия вызовов MiMo) ---------
# По умолчанию ВЫКЛЮЧЕН (false) — старое поведение не меняется.
LOCAL_VLM_ENABLED=false
# shadow = анализировать локально и сравнивать с MiMo, НЕ влияя на решение
# active = разрешить авто-reject по LOCAL_VLM_AUTO_REJECT_FLAGS (после валидации)
# off    = не анализировать
LOCAL_VLM_MODE=shadow
# OpenAI-совместимый сервер llama.cpp (llama-server)
LOCAL_VLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_VLM_MODEL=smolvlm2-2.2b
# llama.cpp обычно без ключа; задайте, если вы включили --api-key на сервере
LOCAL_VLM_API_KEY=
LOCAL_VLM_TIMEOUT_SECONDS=90
# Только 1 inference одновременно (4 ГБ VRAM)
LOCAL_VLM_MAX_CONCURRENCY=1
# Уменьшать кадр до этой стороны перед отправкой (экономия VRAM/времени)
LOCAL_VLM_MAX_IMAGE_SIDE=512
# 200 обрезало JSON с evidence — для SmolVLM2 ставь 400
LOCAL_VLM_MAX_OUTPUT_TOKENS=400
# Признаки для авто-reject в active-режиме (через запятую). Пусто = авто-reject выключен.
# Начинать ТОЛЬКО с признаков, подтверждённых на shadow-выборке высокой precision.
LOCAL_VLM_AUTO_REJECT_FLAGS=

# --- TagMe таймауты (мс) -------------------------------------
TAGME_TIMEOUT_MS=15000
TAGME_READY_TIMEOUT_MS=30000
TAGME_SEND_TIMEOUT_MS=30000
